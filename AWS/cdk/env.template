# --- IOTStack ---
CLIENT_ID=raspberrypi-1
DEVICE_CERT_ARN=arn:aws:iot:region:account:cert/<sha256 hex of device cert>
MOBILE_APP_NAME=prod-mobile-app
MOBILE_APP_CERT_ARN=arn:aws:iot:region:account:cert/<sha256 hex of mobile app cert>

# --- LambdaStack ---
CUSTOM_DOMAIN_NAME=example.com
R53_ZONE_ID=Z00000000000000000000
LAMBDA_VERSION=0.0.1

