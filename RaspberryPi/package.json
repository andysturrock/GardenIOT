{
  "name": "gardeniot",
  "version": "1.0.0",
  "description": "Raspberry Pi parts of GardenIOT project",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "aws-crt": "^1.27.4",
    "aws-iot-device-sdk-v2": "^1.21.0",
    "dotenv": "^17.0.0",
    "node-schedule": "^2.1.1",
    "rpi-gpio": "^2.1.7",
    "tslog": "^3.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-schedule": "^2.1.0",
    "@types/rpi-gpio": "^2.1.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.0.0",
    "eslint-plugin-promise": "^6.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "//overrides-rationale": "uuid is forced to ^11.1.1 to silence GHSA-w5hq-g745-h8pq. aws-iot-device-sdk-v2 pins uuid ^8.3.2 transitively; the advisory only affects v3/v5/v6 generators called with a buf param, and the SDK only uses v4 (whose signature is stable 8->11), so the override is API-safe.",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "build": "npm run clean && tsc --build && cp ./.env ./dist && cp -r ./node_modules ./dist",
    "clean": "rm -rf ./dist",
    "start": "node --enable-source-maps dist/index.js",
    "start:dev": "ts-node --enable-source-maps index.ts",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andysturrock/GardenIOT.git"
  },
  "author": "Andy Sturrock",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/andysturrock/GardenIOT/issues"
  },
  "homepage": "https://github.com/andysturrock/GardenIOT#readme"
}
