[Unit]
Description=GardenIOT auto-deploy (git pull + build + pm2 reload)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Set User= to whichever account owns the git checkout AND the pm2 daemon.
User=pm2
Group=pm2
# Path to the checkout's deploy.sh. Adjust to match your layout.
ExecStart=/opt/pm2_programs/git_repos/GardenIOT/RaspberryPi/deploy.sh
# Capture output in the journal under the unit name.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gardeniot-deploy
