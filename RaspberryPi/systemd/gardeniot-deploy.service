[Unit]
Description=GardenIOT auto-deploy (git pull + build + pm2 reload)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Set User= to whichever account owns the git checkout AND the pm2 daemon.
User=pm2
Group=pm2
# Resolve $HOME from the User=pm2 entry in /etc/passwd so we don't have
# to hardcode the pm2 user's home directory. systemd sets $HOME from
# the User=, then bash -c expands it.
ExecStart=/bin/bash -c 'exec "$HOME/git_repos/GardenIOT/RaspberryPi/deploy.sh"'
# Capture output in the journal under the unit name.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gardeniot-deploy
